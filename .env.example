# Copy this file to .env and fill in real values. .env is gitignored; never commit real keys.

ENVIRONMENT=development
LOG_LEVEL=INFO

# At least one of these is required for POST /api/analyze to work.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3

# SQLite is fine for local dev; see DECISIONS.md for the PostgreSQL swap path.
DATABASE_URL=sqlite+aiosqlite:///./data/feedback.db
CACHE_TTL_SECONDS=3600
